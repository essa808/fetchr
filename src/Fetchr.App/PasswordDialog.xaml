<Window x:Class="Fetchr.App.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Fetchr.App"
        Style="{StaticResource Dialog}" Width="440" Title="{DynamicResource S.Pwd.Title}">
  <StackPanel>
    <StackPanel Margin="24,20,24,16">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,8" TextElement.Foreground="{DynamicResource Brush.Warning}">
        <app:IconView Data="{StaticResource Icon.Lock}" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="{DynamicResource S.Pwd.Title}" Style="{StaticResource Title}" Foreground="{DynamicResource Brush.Text}" />
      </StackPanel>
      <TextBlock x:Name="ArchiveName" Style="{StaticResource Num}" FontWeight="SemiBold" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
      <TextBlock Text="{DynamicResource S.Pwd.Body}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,16" />

      <Label Content="{DynamicResource S.Pwd.Password}" Target="{Binding ElementName=Pwd}" Style="{StaticResource FieldLabel}" />
      <Border x:Name="PwdBorder" BorderThickness="1" BorderBrush="{DynamicResource Brush.BorderInput}" CornerRadius="{DynamicResource Radius.Md}"
              Background="{DynamicResource Brush.Surface}" Height="{DynamicResource Size.ControlMd}">
        <PasswordBox x:Name="Pwd" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Text}"
                     CaretBrush="{DynamicResource Brush.Text}" VerticalContentAlignment="Center" Padding="8,0" FlowDirection="LeftToRight"
                     PasswordChanged="OnPasswordChanged" />
      </Border>
      <StackPanel x:Name="ErrorRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed" TextElement.Foreground="{DynamicResource Brush.Danger}">
        <app:IconView Data="{StaticResource Icon.CircleX}" Margin="0,0,6,0" VerticalAlignment="Top" />
        <TextBlock Text="{DynamicResource S.Pwd.Wrong}" TextWrapping="Wrap" FontSize="{DynamicResource Type.Caption.Size}" MaxWidth="360"
                   AutomationProperties.LiveSetting="Assertive" />
      </StackPanel>
      <CheckBox x:Name="Remember" Content="{DynamicResource S.Pwd.Remember}" IsChecked="True" Margin="0,16,0,0" />
    </StackPanel>
    <Border Style="{StaticResource DialogFooter}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource BtnGhost}" Content="{DynamicResource S.Cancel}" IsCancel="True" Margin="0,0,8,0" />
        <Button x:Name="UnpackButton" Style="{StaticResource BtnPrimary}" IsDefault="True" Click="OnUnpack" IsEnabled="False">
          <StackPanel Orientation="Horizontal">
            <app:IconView Data="{StaticResource Icon.Archive}" Margin="0,0,8,0" />
            <TextBlock Text="{DynamicResource S.Pwd.Unpack}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
