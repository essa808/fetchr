<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Fetchr.Core\Fetchr.Core.csproj" />
    <ProjectReference Include="..\Fetchr.Host\Fetchr.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); keep WinForms names out of the global namespace. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\installer\fetchr.ico</ApplicationIcon>
    <AssemblyName>Fetchr.App</AssemblyName>
    <Product>Fetchr</Product>
    <Version>0.2.0</Version>
    <Description>Fetchr download manager</Description>
  </PropertyGroup>

  <!-- The unpacked browser extension ships next to the app, for "Load unpacked". -->
  <ItemGroup>
    <None Include="..\..\extension\**" LinkBase="extension" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
