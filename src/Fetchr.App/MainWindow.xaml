<Window x:Class="Fetchr.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Fetchr.App"
        Style="{StaticResource AppWindow}"
        Title="Fetchr" Width="1100" Height="640"
        MinWidth="{DynamicResource Size.WindowMinW}" MinHeight="{DynamicResource Size.WindowMinH}">
  <Window.InputBindings>
    <KeyBinding Key="N" Modifiers="Control" Command="{x:Static app:MainWindow.AddLinkCommand}" />
    <KeyBinding Key="V" Modifiers="Control" Command="{x:Static app:MainWindow.AddLinkCommand}" />
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="{x:Static app:MainWindow.AddLinkCommand}" Executed="OnAddLink" />
  </Window.CommandBindings>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="{StaticResource Length.Statusbar}" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="8,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Content="{DynamicResource S.AutoExtract}" IsChecked="{Binding AutoExtract}" Margin="0,0,16,0" />
          <Button x:Name="SettingsButton" Style="{StaticResource BtnSecondary}" Height="{DynamicResource Size.ControlSm}" Padding="12,0"
                  Content="{DynamicResource S.Settings}" Click="OnSettings" Margin="0,0,8,0" />
          <Button x:Name="LangButton" Style="{StaticResource BtnSecondary}" Height="{DynamicResource Size.ControlSm}" Padding="12,0"
                  Click="OnToggleLanguage" AutomationProperties.Name="Language / اللغة" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" ToolBar.OverflowMode="Never">
          <Button Style="{StaticResource BtnTool}" Content="{DynamicResource S.AddLink}" Tag="{StaticResource Icon.Link}" Click="OnAddLink" ToolTip="Ctrl+N" />
          <Button x:Name="ResumeButton" Style="{StaticResource BtnTool}" Content="{DynamicResource S.Resume}" Tag="{StaticResource Icon.Play}" Click="OnResume" />
          <Button x:Name="PauseButton" Style="{StaticResource BtnTool}" Content="{DynamicResource S.Pause}" Tag="{StaticResource Icon.Pause}" Click="OnPause" ToolTip="Space" />
          <Button x:Name="ExtractButton" Style="{StaticResource BtnTool}" Content="{DynamicResource S.Extract}" Tag="{StaticResource Icon.Archive}" Click="OnExtract" />
          <Button x:Name="FolderButton" Style="{StaticResource BtnTool}" Content="{DynamicResource S.OpenFolder}" Tag="{StaticResource Icon.FolderOpen}" Click="OnOpenFolder" />
          <Button x:Name="DeleteButton" Style="{StaticResource BtnTool}" Content="{DynamicResource S.Delete}" Tag="{StaticResource Icon.Trash2}" Click="OnDelete" ToolTip="Del" />
          <Border Width="1" Margin="8,10" Background="{DynamicResource Brush.Border}" />
          <Button x:Name="BrowserButton" Style="{StaticResource BtnTool}" Content="{DynamicResource S.Browser}" Tag="{StaticResource Icon.Globe}" Click="OnBrowser" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{StaticResource Length.Sidebar}" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Sidebar -->
      <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="8">
        <ListBox x:Name="Filters" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SideItem}"
                 SelectionChanged="OnFilterChanged" AutomationProperties.Name="Filters">
          <ListBoxItem Tag="all">
            <StackPanel Orientation="Horizontal"><app:IconView Data="{StaticResource Icon.Layers}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource S.Filter.All}" /></StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="downloading">
            <StackPanel Orientation="Horizontal"><app:IconView Data="{StaticResource Icon.ArrowDown}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource S.Filter.Downloading}" /></StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="completed">
            <StackPanel Orientation="Horizontal"><app:IconView Data="{StaticResource Icon.CircleCheck}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource S.Filter.Completed}" /></StackPanel>
          </ListBoxItem>
          <ListBoxItem Tag="unfinished">
            <StackPanel Orientation="Horizontal"><app:IconView Data="{StaticResource Icon.Clock}" Margin="0,0,8,0" /><TextBlock Text="{DynamicResource S.Filter.Unfinished}" /></StackPanel>
          </ListBoxItem>
          <!-- Category items are added in code, after this header. -->
          <ListBoxItem x:Name="CategoriesHeader" IsEnabled="False" Focusable="False" Height="28" Margin="0,8,0,0">
            <TextBlock Text="{DynamicResource S.Filter.Categories}" FontSize="{DynamicResource Type.Caption.Size}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.TextMuted}" />
          </ListBoxItem>
        </ListBox>
      </Border>

      <!-- Download table -->
      <DataGrid x:Name="DownloadsGrid" Grid.Column="1" ItemsSource="{Binding View}" SelectionChanged="OnSelectionChanged"
                MouseDoubleClick="OnRowDoubleClick" PreviewKeyDown="OnGridKey" AutomationProperties.Name="Downloads">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="{DynamicResource S.Col.Name}" Width="2*" SortMemberPath="Name">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" Style="{StaticResource Num}" HorizontalAlignment="Left" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{DynamicResource S.Col.Size}" Width="90" SortMemberPath="Total">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding SizeText}" Style="{StaticResource Num}" HorizontalAlignment="Left" /></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{DynamicResource S.Col.Status}" Width="150" SortMemberPath="Status">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StatusPill}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{DynamicResource S.Col.Progress}" Width="130" SortMemberPath="Progress">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Tag="{Binding ProgressTag}"
                             AutomationProperties.HelpText="{Binding DownloadedText}" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{DynamicResource S.Col.Speed}" Width="100" SortMemberPath="BytesPerSecond">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding SpeedText}" Style="{StaticResource Num}" HorizontalAlignment="Left" /></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{DynamicResource S.Col.TimeLeft}" Width="80">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding EtaText}" Style="{StaticResource Num}" HorizontalAlignment="Left" /></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="{DynamicResource S.Col.Added}" Width="140">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate><TextBlock Text="{Binding AddedText}" Style="{StaticResource Caption}" FlowDirection="LeftToRight" HorizontalAlignment="Left" /></DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <!-- Empty state -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                  Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
        <app:IconView Data="{StaticResource Icon.Inbox}" Width="32" Height="32" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,0,12" />
        <TextBlock x:Name="EmptyTitle" Text="{DynamicResource S.Empty.Title}" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="EmptyHint" Text="{DynamicResource S.Empty.Hint}" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,16" />
        <Button x:Name="EmptyAdd" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Center" Click="OnAddLink">
          <StackPanel Orientation="Horizontal">
            <app:IconView Data="{StaticResource Icon.Link}" Margin="0,0,8,0" />
            <TextBlock Text="{DynamicResource S.AddLink}" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Brush.TextMuted}">
        <app:IconView Data="{StaticResource Icon.ArrowDown}" Width="14" Height="14" Margin="0,0,6,0" />
        <TextBlock Text="{Binding TotalSpeedText}" Style="{StaticResource Num}" FontSize="{DynamicResource Type.Caption.Size}" />
        <TextBlock Text="  ·  " FontSize="{DynamicResource Type.Caption.Size}" />
        <TextBlock Text="{Binding ActiveText}" FontSize="{DynamicResource Type.Caption.Size}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
