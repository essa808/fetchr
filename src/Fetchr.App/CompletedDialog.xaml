<Window x:Class="Fetchr.App.CompletedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Fetchr.App"
        Style="{StaticResource Dialog}" Title="{DynamicResource S.Done.Title}">
  <StackPanel>
    <StackPanel Margin="24,20,24,16">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,12" TextElement.Foreground="{DynamicResource Brush.Success}">
        <app:IconView Data="{StaticResource Icon.CircleCheck}" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Text="{DynamicResource S.Done.Title}" Style="{StaticResource Title}" Foreground="{DynamicResource Brush.Text}" />
      </StackPanel>
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Style="{StaticResource Num}" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="{Binding SizeText}" Style="{StaticResource Caption}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,2,0,0" />
      <TextBlock Text="{Binding FullPath}" Style="{StaticResource Caption}" FontFamily="{DynamicResource Font.Mono}" FlowDirection="LeftToRight"
                 HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="0,2,0,12" />

      <!-- Extraction state (archives only): extracting → extracted / failed, live -->
      <ContentPresenter x:Name="ExtractState" Content="{Binding}" ContentTemplate="{StaticResource StatusPill}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding ExtractedTo}" Style="{StaticResource Caption}" FontFamily="{DynamicResource Font.Mono}" FlowDirection="LeftToRight"
                 HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
      <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorLine}" Margin="0,4,0,0" />

      <CheckBox x:Name="DontShow" Content="{DynamicResource S.Done.DontShow}" Margin="0,16,0,0" />
    </StackPanel>

    <Border Style="{StaticResource DialogFooter}">
      <WrapPanel HorizontalAlignment="Right">
        <Button Style="{StaticResource BtnGhost}" Content="{DynamicResource S.Close}" IsCancel="True" Click="OnClose" Margin="0,0,8,0" />
        <Button Style="{StaticResource BtnSecondary}" Content="{DynamicResource S.OpenFolder}" Click="OnFolder" Margin="0,0,8,0" />
        <Button x:Name="OpenButton" Style="{StaticResource BtnPrimary}" IsDefault="True" Click="OnOpen">
          <StackPanel Orientation="Horizontal">
            <app:IconView x:Name="OpenIcon" Data="{StaticResource Icon.ExternalLink}" Margin="0,0,8,0" />
            <TextBlock x:Name="OpenText" Text="{DynamicResource S.Open}" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </Border>
  </StackPanel>
</Window>
